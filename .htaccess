# Bloomington Velo -- static site. No build step; files are served as committed.
#
# wp-content/uploads/ is NOT a WordPress installation. It holds six legacy
# image files that a verbatim roster bio on /team/ references by absolute
# URL. See wp-content/README.md before touching that folder.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A. The Route Library moved from /team/ride-library/ to /ride/routes/.
  # This MUST come before the catch-all below, which would otherwise send
  # it to the homepage instead of its new location.
  RewriteRule ^team/ride-library/?$ /ride/routes/ [R=301,L]

  # B. Retire the WordPress content that was deliberately removed: 387 news
  # posts that lived at the site root, plus /photos/, /news/, and WP
  # taxonomy and feed artifacts. Any non-existent extensionless path 301s
  # to the homepage. Requests that look like assets keep their extension,
  # fall through, and hit the 404 page. The {2,12} bound matches the
  # widened extension pattern in tools/verify.mjs -- with {2,5} a missing
  # .webmanifest would 301 to the homepage instead of 404ing.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,12}$
  RewriteRule ^ / [R=301,L]

  # C. Force HTTPS and the canonical apex host, redirecting www. to the
  # bare domain -- but never touching the dev.bloomingtonvelo.org staging
  # subdomain, which is excluded from every condition below.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.bloomingtonvelo\.org$ [NC]
  RewriteCond %{HTTP_HOST} !^dev\.bloomingtonvelo\.org$ [NC]
  RewriteRule ^ https://bloomingtonvelo.org%{REQUEST_URI} [R=301,L]
</IfModule>

# D. Basic serving behavior.
ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  # E. Security headers. The CSP is derived from what the nine pages
  # actually load -- see task-13-report.md for the origin-by-origin
  # breakdown. There is no inline executable script anywhere on the site
  # (the two <script type="application/ld+json"> blocks are data, not
  # code, and are not governed by script-src), so script-src carries no
  # 'unsafe-inline'. Inline style="" attributes are used throughout the
  # verbatim roster-bio content, so style-src needs 'unsafe-inline'.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.bloomingtonvelo.org https://s.w.org https://dgalywyr863hv.cloudfront.net; font-src 'self'; connect-src 'self' https://www.googleapis.com; frame-src https://calendar.google.com https://www.strava.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"

  # F. Staging must never be indexed. Production and staging share this
  # file, so this is keyed on the host rather than being a separate file.
  <If "%{HTTP_HOST} == 'dev.bloomingtonvelo.org'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

# G. Caching. assets/ and the rescued wp-content/uploads/ images are
# fingerprint-free but change rarely, so both are cached hard by extension;
# HTML is revalidated on every request so edits go live immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpe?g|webp|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml
</IfModule>
